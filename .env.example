# ==============================================================================
# .env.example - Contrato Declarativo de Variáveis de Ambiente
# Projeto: Arquitetura de Sistemas Inteligentes (Padrão PycoderBR / SCSI)
# Instruções: Copie este arquivo para .env e preencha com seus valores locais.
# NUNCA comite o arquivo .env real no controle de versão (protegido por .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Globais da Aplicação (Django Core & WSGI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-change-me-in-production-generate-50-chars-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,app.seudominio.com.br
CSRF_TRUSTED_ORIGINS=https://app.seudominio.com.br,http://localhost:8000
INTERNAL_IPS=127.0.0.1

# ------------------------------------------------------------------------------
# 2. Banco de Dados Relacional Primário (PostgreSQL 16+)
# ------------------------------------------------------------------------------
POSTGRES_DB=scsi_database
POSTGRES_USER=scsi_user
POSTGRES_PASSWORD=scsi_super_secret_password_change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://scsi_user:scsi_super_secret_password_change_me@postgres:5432/scsi_database

# ------------------------------------------------------------------------------
# 3. Armazenamento em Memória, Cache & Sessões (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Mensageria & Broker Assíncrono (RabbitMQ 3+)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=scsi_rabbit_user
RABBITMQ_DEFAULT_PASS=scsi_rabbit_secret_password_change_me
RABBITMQ_DEFAULT_VHOST=scsi_vhost
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://scsi_rabbit_user:scsi_rabbit_secret_password_change_me@rabbitmq:5672/scsi_vhost

# ------------------------------------------------------------------------------
# 5. Processamento Assíncrono em Background (Celery Worker & Celery Beat)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=amqp://scsi_rabbit_user:scsi_rabbit_secret_password_change_me@rabbitmq:5672/scsi_vhost
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# ------------------------------------------------------------------------------
# 6. Serviços Externos de IA & Orquestração de Agentes (LangChain / LangGraph)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Observabilidade & Rastreabilidade de Agentes (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here
LANGCHAIN_PROJECT=scsi-agentes-inteligentes

# ------------------------------------------------------------------------------
# 7. Borda, Roteamento Ingress & Certificados SSL (Cloudflare & Traefik)
# ------------------------------------------------------------------------------
DOMAIN_NAME=seudominio.com.br
TRAEFIK_ACME_EMAIL=admin@seudominio.com.br
CF_API_EMAIL=seu_email_cloudflare@dominio.com
CF_API_KEY=sua_chave_global_api_cloudflare
CF_DNS_API_TOKEN=seu_token_api_cloudflare_dns_edit

# Credencial do Dashboard do Traefik (Gerar com: htpasswd -nb admin senha)
# Exemplo: admin:$apr1$xyz...
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkTrqE8wj/
