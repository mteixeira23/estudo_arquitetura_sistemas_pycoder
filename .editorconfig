# ==============================================================================
# EditorConfig - Governança de Código (Padrão PycoderBR / SCSI)
# https://editorconfig.org
# ==============================================================================

root = true

# Padrão Global para Todos os Arquivos
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Arquivos Python (Alinhado à PEP 8 e Ruff)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# Arquivos de Configuração Estruturada (YAML, JSON, TOML)
[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

# Arquivos de Documentação e Marcação (Markdown, HTML)
# Preserva espaços no fim de linha em Markdown (usados como quebra de linha <br>)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.html]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Scripts Shell e Entrypoints de Containers Linux
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 4

# Infraestrutura Docker & Compose
[{Dockerfile,Dockerfile.*,docker-compose*.yml}]
end_of_line = lf
indent_style = space
indent_size = 2

# Arquivos de Variáveis de Ambiente
[.env*]
end_of_line = lf
trim_trailing_whitespace = true
